# Variables de entorno - copia este archivo a .env y ajusta los valores
# (.env no se versiona)

# Configuración de la aplicación
VITE_APP_NAME=signals-starter-kit
VITE_APP_VERSION=1.0.0

# Desarrollo / logging
VITE_DEV_MODE=true
# Niveles: TRACE | DEBUG | INFO | WARN | ERROR | SILENT
VITE_LOG_LEVEL=DEBUG

# API (si usas una API real en el futuro)
# VITE_API_URL=https://api.example.com
# VITE_API_TIMEOUT=10000

# Feature flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false

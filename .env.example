# Variables de entorno - copia este archivo a .env y ajusta los valores
# (.env no se versiona)

# Configuración de la aplicación
VITE_APP_NAME=signals-starter-kit
# Por defecto se usa la versión de package.json
# VITE_APP_VERSION=1.0.0

# Desarrollo / logging
VITE_DEV_MODE=true
# Niveles: TRACE | DEBUG | INFO | WARN | ERROR | SILENT
VITE_LOG_LEVEL=DEBUG
# Panel de devtools en desarrollo (contador de effects y resaltado): pon false para ocultarlo
# VITE_DEVTOOLS=false

# API: disponibles como config.apiUrl y config.apiTimeout (ms, 0 = sin límite)
# VITE_API_URL=https://api.example.com
# VITE_API_TIMEOUT=10000

# Feature flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false
